{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VibeBasic",
  "version": "../package.json",
  "identifier": "no.vibebasic.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeBasic",
        "width": 1024,
        "height": 768,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Apple Development: Stig Joran Moen (KPD3KXHZ2Q)"
    }
  }
}
