{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The IDE / app main window: the core and dialog permissions and every app command (see src/app_commands.rs)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "allow-ai-list-models",
    "allow-ai-chat",
    "allow-ai-cancel",
    "allow-ai-settings-get",
    "allow-ai-settings-set",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-read-binary-file",
    "allow-list-volumes",
    "allow-list-dir",
    "allow-fio-open",
    "allow-fio-read",
    "allow-fio-write",
    "allow-fio-close",
    "allow-fio-reset",
    "allow-fs-kill",
    "allow-fs-rename",
    "allow-fs-mkdir",
    "allow-fs-rmdir",
    "allow-fs-copy",
    "allow-fs-set-attr",
    "allow-fs-stat",
    "allow-setting-get",
    "allow-setting-save",
    "allow-setting-delete",
    "allow-setting-all",
    "allow-db-open",
    "allow-db-query",
    "allow-db-execute",
    "allow-db-close",
    "allow-db-reset",
    "allow-inet-request",
    "allow-inet-cancel",
    "allow-sock-connect",
    "allow-sock-listen",
    "allow-sock-accept",
    "allow-sock-bind",
    "allow-sock-send",
    "allow-sock-close",
    "allow-net-reset",
    "allow-net-local-ip",
    "allow-comm-list",
    "allow-comm-open",
    "allow-comm-configure",
    "allow-comm-write",
    "allow-comm-set-lines",
    "allow-comm-close",
    "allow-comm-reset",
    "allow-sys-info",
    "allow-media-open",
    "allow-media-read",
    "allow-media-close",
    "allow-clipboard-get-text",
    "allow-clipboard-set-text",
    "allow-make-app",
    "allow-can-make-app",
    "allow-get-embedded-project",
    "allow-quit-app",
    "allow-get-app-dir",
    "allow-get-app-name",
    "allow-printer-list",
    "allow-print-window"
  ]
}
