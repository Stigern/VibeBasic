{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "run-windows",
  "description": "Form and dialog windows of a running VB program (form.html): events, moving/sizing their own window, and reading a media file the main window opened (media_read). No other app command.",
  "windows": [
    "vbform-*",
    "vbdialog-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "allow-media-read"
  ]
}
